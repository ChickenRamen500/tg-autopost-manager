# Telegram
# BOT_TOKEN — от @BotFather. Без него бот не запустится (polling невозможен).
BOT_TOKEN=

# TELEGRAM_API_ID и TELEGRAM_API_HASH — ОБЯЗАТЕЛЬНЫ для Local Bot API Server.
# Получить на https://my.telegram.org (раздел "API development tools").
# Без них контейнер tg-lba стартует БЕЗ флага --local и НЕ открывает порт 8081 → unhealthy.
# Docker compose использует `${TELEGRAM_API_ID:?...}` — если переменная пустая, контейнер упадёт
# с понятной ошибкой при старте (вместо того, чтобы тихо стать unhealthy).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API Server (ТЗ §3.3)
BOT_API_URL=http://local-bot-api:8081

# Безопасность (для REST API и Chrome-расширения)
# X-Secret-Token, проверяемый на /health/bot-api и /health/scheduler.
# В production ОБЯЗАТЕЛЬНО задайте — иначе эти endpoints открыты без auth.
SECRET_TOKEN=

# База данных
# Сейчас используется sqlite:///./data/bot.db напрямую (app/db/database.py),
# DATABASE_URL пока не парсится в коде и оставлен для будущей миграции на PostgreSQL.
DATABASE_URL=sqlite:///./data/bot.db

# Веб-интерфейс (ТЗ §7) — порт FastAPI; в docker-compose выставлен на 127.0.0.1
WEB_PORT=8000
TZ=Asia/Yekaterinburg

# Фаза 1: чат для теста загрузки 300 МБ (id ЛС с ботом или тестового канала)
TEST_CHAT_ID=

# --- Пути ---
# MEDIA_DIR — путь ВНУТРИ контейнера (Docker volume). На хосте переопределяется MEDIA_HOST_DIR.
MEDIA_DIR=/app/media

# MEDIA_HOST_DIR — путь на ХОСТЕ, который пробрасывается в контейнер как /app/media.
# Кросс-платформенно: на Windows можно указать абсолютный путь D:\Media,
# на Linux/macOS — ./data/media (по умолчанию) или /var/lib/tg-bot/media.
# В docker-compose: ${MEDIA_HOST_DIR:-./data/media}:/app/media
MEDIA_HOST_DIR=./data/media

# Volume bot-api-data внутри контейнера bot (для прямого чтения файлов >20 МБ).
# Также задаётся как ENV в Dockerfile, здесь продублирован для запуска вне Docker.
BOT_API_DATA_MOUNT=/app/bot-api-data

# Таймаут загрузки больших файлов через Local Bot API, сек (по умолчанию 600)
# Увеличьте, если upload 200+ МБ на хосте дольше этого времени даёт Request timeout
# BOT_API_UPLOAD_TIMEOUT=600

# ===== Фаза 2 (ТЗ §13: БД + приём из ЛС + очереди) =====

# Первичный admin (ТЗ §2.6). Ваш tg_id (узнать у @userinfobot).
# На первом /start пользователь с этим tg_id автоматически становится admin.
# Без этого никто не сможет добавлять пользователей/каналы/очереди.
ADMIN_TG_ID=

# Планировщик (ТЗ §2.5.2):
# Минимальная пауза между отправками в одну очередь, сек (защита от 429)
SEND_THROTTLE_SECONDS=1.1
# Лимит попыток отправки поста до перевода в failed
MAX_SEND_ATTEMPTS=3

# Часовой пояс для daily_window очередей (IANA, см. https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Asia/Yekaterinburg

# ===== Фаза 3 (ТЗ §4.2.2: worker — обработка task_queue) =====

# Интервал опроса task_queue на новые queued-задачи, сек.
# Короткий = быстрая реакция + расход CPU/БД; длинный = экономия, но задержка.
WORKER_POLL_INTERVAL_SECONDS=2.0

# Лимит попыток выполнения задачи (download) до перевода в status='error'.
# task_queue.attempts инкрементируется при каждом захвате (take_next).
WORKER_MAX_ATTEMPTS=3

# Зависшие in_progress задачи старше этого количества минут сбрасываются
# в queued (worker упал / рестарт контейнера / OOM-kill).
WORKER_STALE_TIMEOUT_MINUTES=30

# Таймаут HTTP-скачивания внешних файлов (Gelbooru/Pikabu/...), сек.
WORKER_DOWNLOAD_TIMEOUT_SECONDS=120

# Период запуска cleanup-процедуры (reset_stale_in_progress), сек.
WORKER_CLEANUP_INTERVAL_SECONDS=300

# ===== Фаза 3, этап 2: pHash-дедупликация (ТЗ §2.4.3) =====

# Включить визуальную дедупликацию (imagehash.phash + Hamming distance).
# False → посты помечаются possible_duplicate только по file_unique_id (точный уровень).
PHASH_ENABLED=1

# Порог расстояния Хэмминга: ≤ = дубликат. 0 = точное совпадение, 5 = «похожие»
# (рекомендация imagehash для устойчивости к ресайзу/перекомпрессии). >8 — много false positives.
PHASH_MAX_DISTANCE=5

# Скачивать thumbnail фото из ЛС для pHash-проверки при приёме.
# ТЗ §2.1.1: «файл НЕ скачивается при приёме» — thumbnail это минимальное исключение
# ради дедупликации (几 KB вместо мегабайт). False → pHash только после явной обработки (worker).
PHASH_CHECK_ON_RECEIVE=1

# Миграция gbooru_tg — GelbooruClient (ТЗ §10). Опционально для Фазы 2:
# потребуются автопарсингу подписок (Фаза 3). Получить на https://gelbooru.com/index.php?page=account&s=options
# GELBOORU_API_KEY=
# GELBOORU_USER_ID=
