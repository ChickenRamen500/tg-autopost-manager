# Telegram
# BOT_TOKEN — от @BotFather. Без него бот не запустится (polling невозможен).
BOT_TOKEN=

# TELEGRAM_API_ID и TELEGRAM_API_HASH — ОБЯЗАТЕЛЬНЫ для Local Bot API Server.
# Получить на https://my.telegram.org (раздел "API development tools").
# Без них контейнер tg-lba стартует БЕЗ флага --local и НЕ открывает порт 8081 → unhealthy.
# Docker compose использует `${TELEGRAM_API_ID:?...}` — если переменная пустая, контейнер упадёт
# с понятной ошибкой при старте (вместо того, чтобы тихо стать unhealthy).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API Server (ТЗ §3.3)
BOT_API_URL=http://local-bot-api:8081

# Безопасность (для REST API и Chrome-расширения)
# X-Secret-Token, проверяемый на /health/bot-api и /health/scheduler.
# В production ОБЯЗАТЕЛЬНО задайте — иначе эти endpoints открыты без auth.
SECRET_TOKEN=

# База данных
# Сейчас используется sqlite:///./data/bot.db напрямую (app/db/database.py),
# DATABASE_URL пока не парсится в коде и оставлен для будущей миграции на PostgreSQL.
DATABASE_URL=sqlite:///./data/bot.db

# Веб-интерфейс (ТЗ §7) — порт FastAPI; в docker-compose выставлен на 127.0.0.1
WEB_PORT=8000
TZ=Asia/Yekaterinburg

# Фаза 1: чат для теста загрузки 300 МБ (id ЛС с ботом или тестового канала)
TEST_CHAT_ID=

# --- Пути ---
# MEDIA_DIR — путь ВНУТРИ контейнера (Docker volume). На хосте переопределяется MEDIA_HOST_DIR.
MEDIA_DIR=/app/media

# MEDIA_HOST_DIR — путь на ХОСТЕ, который пробрасывается в контейнер как /app/media.
# Кросс-платформенно: на Windows можно указать абсолютный путь D:\Media,
# на Linux/macOS — ./data/media (по умолчанию) или /var/lib/tg-bot/media.
# В docker-compose: ${MEDIA_HOST_DIR:-./data/media}:/app/media
MEDIA_HOST_DIR=./data/media

# Volume bot-api-data внутри контейнера bot (для прямого чтения файлов >20 МБ).
# Также задаётся как ENV в Dockerfile, здесь продублирован для запуска вне Docker.
BOT_API_DATA_MOUNT=/app/bot-api-data

# Таймаут загрузки больших файлов через Local Bot API, сек (по умолчанию 600)
# Увеличьте, если upload 200+ МБ на хосте дольше этого времени даёт Request timeout
# BOT_API_UPLOAD_TIMEOUT=600

# ===== Фаза 2 (ТЗ §13: БД + приём из ЛС + очереди) =====

# Первичный admin (ТЗ §2.6). Ваш tg_id (узнать у @userinfobot).
# На первом /start пользователь с этим tg_id автоматически становится admin.
# Без этого никто не сможет добавлять пользователей/каналы/очереди.
ADMIN_TG_ID=

# Планировщик (ТЗ §2.5.2):
# Минимальная пауза между отправками в одну очередь, сек (защита от 429)
SEND_THROTTLE_SECONDS=1.1
# Лимит попыток отправки поста до перевода в failed
MAX_SEND_ATTEMPTS=3

# Часовой пояс для daily_window очередей (IANA, см. https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Asia/Yekaterinburg

# ===== Фаза 3 (ТЗ §4.2.2: worker — обработка task_queue) =====

# Интервал опроса task_queue на новые queued-задачи, сек.
# Короткий = быстрая реакция + расход CPU/БД; длинный = экономия, но задержка.
WORKER_POLL_INTERVAL_SECONDS=2.0

# Лимит попыток выполнения задачи (download) до перевода в status='error'.
# task_queue.attempts инкрементируется при каждом захвате (take_next).
WORKER_MAX_ATTEMPTS=3

# Зависшие in_progress задачи старше этого количества минут сбрасываются
# в queued (worker упал / рестарт контейнера / OOM-kill).
WORKER_STALE_TIMEOUT_MINUTES=30

# Таймаут HTTP-скачивания внешних файлов (Gelbooru/Pikabu/...), сек.
WORKER_DOWNLOAD_TIMEOUT_SECONDS=120

# Период запуска cleanup-процедуры (reset_stale_in_progress), сек.
WORKER_CLEANUP_INTERVAL_SECONDS=300

# ===== Фаза 3, этап 2: pHash-дедупликация (ТЗ §2.4.3) =====

# Включить визуальную дедупликацию (imagehash.phash + Hamming distance).
# False → посты помечаются possible_duplicate только по file_unique_id (точный уровень).
PHASH_ENABLED=1

# Порог расстояния Хэмминга: ≤ = дубликат. 0 = точное совпадение, 5 = «похожие»
# (рекомендация imagehash для устойчивости к ресайзу/перекомпрессии). >8 — много false positives.
PHASH_MAX_DISTANCE=5

# Скачивать thumbnail фото из ЛС для pHash-проверки при приёме.
# ТЗ §2.1.1: «файл НЕ скачивается при приёме» — thumbnail это минимальное исключение
# ради дедупликации (几 KB вместо мегабайт). False → pHash только после явной обработки (worker).
PHASH_CHECK_ON_RECEIVE=1

# ===== Фаза 3, этап 3: подписки Gelbooru (ТЗ §2.1.4) =====

# Включить автопарсинг подписок (tag_subscriptions). False → worker НЕ опрашивает
# gelbooru, подписки существуют в БД но не проверяются.
GELBOORU_SUBS_ENABLED=1

# Интервал опроса due-подписок worker'ом, сек. Внутри цикла каждая подписка
# проверяется только если подошёл её check_interval_hours.
GELBOORU_SUBS_POLL_INTERVAL_SECONDS=60

# Лимит постов в одном запросе к gelbooru API (max 100).
GELBOORU_SEARCH_LIMIT=50

# ===== Фаза 3, этап 5: внешние парсеры (ТЗ §2.1.4) =====

# Danbooru: опциональная аутентификация (без неё rate limit 1 req/s).
# Получить на https://danbooru.donmai.us/profile (Login → API Key).
# DANBOORU_LOGIN=
# DANBOORU_API_KEY=

# X.com (Twitter): путь к cookies-файлу (Netscape format).
# Без cookies большинство твитов недоступно (X требует логин).
# Export через браузерное расширение (например "Get cookies.txt LOCALLY").
# XCOM_COOKIES_PATH=/app/data/xcom_cookies.txt

# Pixiv: опциональная аутентификация через PHPSESSID (для R-18 и поиска).
# Получить: войти на pixiv.net → DevTools → Application → Cookies → PHPSESSID.
# PIXIV_SESSION_ID=

# Миграция gbooru_tg — GelbooruClient (ТЗ §10). Опционально для Фазы 2:
# потребуются автопарсингу подписок (Фаза 3). Получить на https://gelbooru.com/index.php?page=account&s=options
# GELBOORU_API_KEY=
# GELBOORU_USER_ID=

# Auto-deploy (CI/CD) — токен для webhook /webhook/deploy.
# GitHub Actions вызывает webhook при push в main → сервер git pull + docker rebuild.
# Сгенерируйте: openssl rand -hex 32
# Задайте тот же токен в GitHub Secrets: DEPLOY_TOKEN
# Если пусто — авто-деплой отключён.
DEPLOY_TOKEN=

# Окно (сек), в течение которого старт бота считается «перезапуском после
# автодеплоя»: если data/deploy.trigger создан не старше этого времени, бот
# шлёт админу «🚀 Бот перезапущен после автодеплоя» (ЛС + служебный канал).
# 900 = запас на git pull + docker compose up --build. По умолчанию 900.
# DEPLOY_RESTART_WINDOW_SECONDS=900

# Наблюдатель за ERROR/CRITICAL в stdout-логе контейнера (docker logs):
# каждые N секунд новые строки ошибок отправляются админу в ЛС одним дайджестом.
# 0 — отключить. По умолчанию 120.
# LOG_ERRORS_SCAN_INTERVAL_SECONDS=120
# Максимум строк-ошибок в одном сообщении (лимит Telegram 4096 симв.). По умолчанию 10.
# LOG_ERRORS_MAX_LINES_PER_REPORT=10

# Дополнительные корневые директории для браузера локальных файлов.
# Список путей через запятую. В Docker: пути ВНУТРИ контейнера
# (добавьте volumes в docker-compose.yml).
# Пример: EXTRA_MEDIA_DIRS=/mnt/media,/mnt/saved_files
#
# ПОДСКАЗКА: проще добавлять папки через веб-интерфейс («Локальные файлы» →
# шестерёнка → «Добавить путь») — можно вставить Windows-путь
# (например N:\media_saver_bot\saved_files), и бот сам найдёт папку
# по всем примонтированным дискам и переведёт её в путь контейнера.
EXTRA_MEDIA_DIRS=

# Автоочистка отправленных файлов: удалять файл с диска сразу после успешной
# отправки поста в TG (только для постов из расширения/парсеров — файл можно
# перекачать по source_url при необходимости). Локальные файлы пользователя
# (source_type='local_file') и посты из Telegram не удаляются никогда.
# Если файл нужен другому неотправленному посту — тоже не удаляется.
# 0/false — отключить автоудаление (по умолчанию включено).
# AUTO_DELETE_SENT_FILES=1

# ===== Уведомление о запуске/перезапуске бота =====
# Через N секунд после старта бот отправляет в служебный канал (и дублирует в
# ЛС админу) ДВА сообщения:
#   1. «🟢 Бот запущен, очереди загружены» — сводка по всем очередям: название,
#      канал, интервал, активность и распределение постов по статусам
#      (pending/sent/failed/new).
#   2. Описание последнего коммита GitHub (что сделано в этой сборке) —
#      берётся из GitHub REST API по GITHUB_REPO / GITHUB_BRANCH.
# 0 — отключить. По умолчанию 60 (даём polling'у и scheduler'у подняться).
# STARTUP_NOTIFY_DELAY_SECONDS=60

# Репозиторий и ветка GitHub для получения описания последнего коммита.
# Формат GITHUB_REPO: owner/repo (например ChickenRamen500/tg-autopost-manager).
# Запрос без auth (rate limit GitHub 60/час — достаточно для одного старта).
# GITHUB_REPO=ChickenRamen500/tg-autopost-manager
# GITHUB_BRANCH=main
