# Telegram
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API Server
BOT_API_URL=http://local-bot-api:8081

# Безопасность (для REST API и Chrome-расширения)
SECRET_TOKEN=

# База данных
DATABASE_URL=sqlite:///./data/bot.db

# Прочее
WEB_PORT=8000
TZ=Europe/Moscow

# Фаза 1: чат для теста загрузки 300 МБ (id ЛС с ботом или тестового канала)
TEST_CHAT_ID=
# Путь к хранилищу медиа (в контейнере /app/media, на хосте смонтирован D:\Media)
MEDIA_DIR=./data/media
BOT_API_DATA_MOUNT=/app/bot-api-data

# Таймаут загрузки больших файлов через Local Bot API, сек (по умолчанию 600)
# Увеличьте, если upload 200+ МБ на хосте дольше этого времени даёт Request timeout
# BOT_API_UPLOAD_TIMEOUT=600

# ===== Фаза 2 (ТЗ §13: БД + приём из ЛС + очереди) =====

# Первичный admin (ТЗ §2.6). Ваш tg_id (узнать у @userinfobot).
# На первом /start пользователь с этим tg_id автоматически становится admin.
# Без этого никто не сможет добавлять пользователей/каналы/очереди.
ADMIN_TG_ID=

# Планировщик (ТЗ §2.5.2):
# Минимальная пауза между отправками в одну очередь, сек (защита от 429)
SEND_THROTTLE_SECONDS=1.1
# Лимит попыток отправки поста до перевода в failed
MAX_SEND_ATTEMPTS=3

# Миграция gbooru_tg — GelbooruClient (ТЗ §10). Опционально для Фазы 2:
# потребуются автопарсингу подписок (Фаза 3). Получить на https://gelbooru.com/index.php?page=account&s=options
# GELBOORU_API_KEY=
# GELBOORU_USER_ID=

